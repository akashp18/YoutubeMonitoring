# Copy to .env and fill in what you use. Everything here is optional:
# without YOUTUBE_API_KEY the monitor discovers Shorts through the public
# channel page with Playwright.

# Optional. Enables official YouTube Data API discovery (recommended).
YOUTUBE_API_KEY=

# Server bind address
YT_MON_HOST=127.0.0.1
YT_MON_PORT=8000

# Storage locations (defaults shown)
# YT_MON_DB_PATH=data/monitoring.db
# YT_MON_EVIDENCE_DIR=evidence

# SMTP is optional. Leave blank to disable e-mail notifications.
YT_MON_SMTP_HOST=
YT_MON_SMTP_PORT=587
YT_MON_SMTP_USERNAME=
YT_MON_SMTP_PASSWORD=
YT_MON_SMTP_FROM=
YT_MON_SMTP_STARTTLS=true
